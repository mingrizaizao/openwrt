part uuid ${devtype} ${devnum}:2 uuid

setenv bootargs "earlycon=uart8250,mmio32,0x20064000 console=ttyFIQ0,115200n8 loglevel=7 root=PARTUUID=${uuid} rootwait rw"

load ${devtype} ${devnum}:1 ${kernel_addr_r} kernel.img
load ${devtype} ${devnum}:1 ${fdt_addr_r} rk3128.dtb

fdt addr ${fdt_addr_r}
fdt set /chosen bootargs "${bootargs}"

bootm ${kernel_addr_r}:kernel-1 - ${fdt_addr_r}