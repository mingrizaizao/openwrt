CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv7=y
CONFIG_TARGET_rockchip_armv7_DEVICE_txcz_rk3128-v3-1=y
CONFIG_DEVEL=y
CONFIG_KERNEL_GIT_CLONE_URI="https://github.com/mingrizaizao/kernel-rockchip.git"
CONFIG_KERNEL_GIT_LOCAL_REPOSITORY=""
CONFIG_KERNEL_GIT_MIRROR_HASH=""
CONFIG_KERNEL_GIT_REF="4fd9da5febe102cb810269e5ed83aa36139ac762"
CONFIG_KERNEL_IO_URING=y
CONFIG_PACKAGE_airoha-en8811h-firmware=y
